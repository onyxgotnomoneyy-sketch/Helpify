{
    "geode": "5.10.1",
    "gd": {
        "win": "2.2081",
        "mac": "2.2081",
        "android32": "2.2081",
        "android64": "2.2081",
        "ios": "2.2081"
    },
    "id": "onyx.helpify",
    "name": "Helpify",
    "version": "v1.0.2",
    "developer": "Onyx",
    "description": "A floating Geometry Dash assistant for level ideas and names.",
    "settings": {
        "assistant-name": {
            "name": "Assistant Name",
            "description": "The name displayed by the assistant.",
            "type": "string",
            "default": "Helpify"
        },
        "icon-scale": {
            "name": "Icon Scale",
            "description": "Changes the size of the floating Helpify icon.",
            "type": "float",
            "default": 1.0,
            "min": 0.5,
            "max": 2.0
        },
        "icon-x": {
            "name": "Icon X",
            "description": "Horizontal position of the floating icon.",
            "type": "float",
            "default": 0.08,
            "min": 0.0,
            "max": 1.0
        },
        "icon-y": {
            "name": "Icon Y",
            "description": "Vertical position of the floating icon.",
            "type": "float",
            "default": 0.15,
            "min": 0.0,
            "max": 1.0
        },
        "text-to-speech": {
            "name": "Text to Speech",
            "description": "Reserved for platform TTS support.",
            "type": "bool",
            "default": false
        }
    },
    "resources": {
        "sprites": [
            "resources/HelpifyIcon.png"
        ]
    }
}
