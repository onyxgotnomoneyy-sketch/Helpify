{
  "geode": "v5.10.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "onyx.helpify",
  "name": "Helpify",
  "version": "v1.0.2",
  "developer": "Onyx",
  "description": "A movable, resizable Geometry Dash level-idea and name assistant.",
  "settings": {
    "assistant-name": {
      "name": "Assistant Name",
      "description": "Change the name displayed by Helpify.",
      "type": "string",
      "default": "Helpify"
    },
    "icon-scale": {
      "name": "Icon Size",
      "description": "Change the size of the floating Helpify icon.",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "control": {
        "slider": true,
        "slider-step": 0.1
      }
    },
    "icon-x": {
      "name": "Icon X Position",
      "description": "Move the floating icon horizontally.",
      "type": "float",
      "default": 0.08,
      "min": 0.0,
      "max": 1.0,
      "control": {
        "slider": true,
        "slider-step": 0.01
      }
    },
    "icon-y": {
      "name": "Icon Y Position",
      "description": "Move the floating icon vertically.",
      "type": "float",
      "default": 0.15,
      "min": 0.0,
      "max": 1.0,
      "control": {
        "slider": true,
        "slider-step": 0.01
      }
    },
    "text-to-speech": {
      "name": "Text To Speech",
      "description": "Reserved for platform TTS support; currently disabled in this iOS-safe build.",
      "type": "bool",
      "default": false
    }
  },
  "resources": {
    "sprites": [
      "resources/HelpifyIcon.png"
    ]
  }
}
